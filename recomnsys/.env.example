# MongoDB Atlas Connection (same as Express backend)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/humans-buy-things-here?retryWrites=true&w=majority

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=your-secret-key-here

# Service Port (different from Express backend on 5000)
PORT=5001
